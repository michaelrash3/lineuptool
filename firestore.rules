rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A coach's account — signed in with Google or an email link. An
    // ANONYMOUS session is a parent who used a public form (the portals sign
    // in anonymously, and that sign-in persists in their browser): it may read
    // the sanitized public mirror and submit the forms, and nothing else — it
    // can never create a team, join one, or resolve an invite code.
    function isCoachAccount() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    match /artifacts/{appId}/users/{uid}/settings/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /artifacts/{appId}/public/data/teams/{teamId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function membersList(data) {
        return data.members != null ? data.members : [];
      }

      function isMember(data) {
        return isSignedIn() && (
          data.ownerId == request.auth.uid ||
          request.auth.uid in membersList(data)
        );
      }

      function isCurrentOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      // Head coach = the current owner OR a member the owner promoted to
      // 'head' via coachRoles (setCoachRole in useTeamMembership). Owner-only
      // would break promoted co-heads. Always evaluated against resource.data
      // (the PRE-write roles), so a write can never grant itself the very
      // privilege it needs.
      function isHeadCoach() {
        return isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.get('coachRoles', {}).get(request.auth.uid, '') == 'head'
        );
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function untouched(key) {
        return !changedKeys().hasAny([key]);
      }

      function ownerIdUnchanged() {
        return !changedKeys().hasAny(['ownerId']);
      }

      function prevMembers() {
        return resource.data.members != null ? resource.data.members : [];
      }

      function nextMembers() {
        return request.resource.data.members != null
          ? request.resource.data.members
          : [];
      }

      function membersAppendOnly() {
        // Every existing member must still be present after the write.
        return nextMembers().toSet().hasAll(prevMembers().toSet());
      }

      function prevCoachRoles() {
        return resource.data.coachRoles != null ? resource.data.coachRoles : {};
      }

      function nextCoachRoles() {
        return request.resource.data.coachRoles != null
          ? request.resource.data.coachRoles
          : {};
      }

      function coachRolesSelfJoinValid() {
        // On the join-code self-join path the caller may only touch their
        // OWN coachRoles entry (existing entries stay byte-for-byte), and
        // that entry must be a real role — never an arbitrary string the
        // role-resolution logic would silently ignore or that could be
        // used to smuggle a bogus privilege value. Mirrors the client
        // guard in useTeamMembership.setCoachRole.
        // The legit client join path (useInviteFlows.joinTeamByCode) only
        // ever sets 'assistant'. Allowing 'head' here let any code-holder —
        // or any EXISTING member reusing this OR'd clause — self-promote to
        // head; promotion to 'head' is the owner's/heads' act through the
        // base update rule.
        return nextCoachRoles().diff(prevCoachRoles()).affectedKeys()
                 .hasOnly([request.auth.uid])
          && nextCoachRoles()[request.auth.uid] == 'assistant';
      }

      function selfRemoveOnly() {
        // The only delta is the caller's own UID being removed (leave-team).
        return prevMembers().toSet().difference(nextMembers().toSet())
          .hasOnly([request.auth.uid]);
      }

      function venmoLinkOk(v) {
        return v == ''
          || (v is string && v.size() <= 200
              && v.matches('https://(www[.]|account[.])?venmo[.]com/[^ <>"]*'));
      }

      function isLegitimateAutoClaim() {
        // Team is genuinely unowned AND caller becomes the new owner AND no
        // other members exist on the previous doc. Mirrors the client-side
        // auto-claim guard in App.jsx — the same race-prevention check that
        // shipped in PR #123 is enforced here at the rules layer so a
        // misbehaving client can't bypass it.
        return (!('ownerId' in resource.data)
                || resource.data.ownerId == null
                || resource.data.ownerId == "")
          && request.resource.data.ownerId == request.auth.uid
          && prevMembers().toSet().difference([request.auth.uid].toSet()).size() == 0;
      }

      // ----- Base team access -----
      // Members can read. Members can update only when:
      //   - ownerId stays the same OR caller is the current owner OR it's a
      //     legitimate first-time auto-claim, AND
      //   - members[] doesn't shrink OR caller is the current owner OR caller
      //     is only removing themselves (assistant leaving a team).
      // The previous "members can write anything" stance was what let the
      // ownership-takeover race demote a head coach in production. The PR
      // #123 client-side guard closes the race in our own code; this rules
      // tightening closes it for any client (or future bug) too.
      allow read: if isMember(resource.data);
      allow update: if isMember(resource.data)
                    && (ownerIdUnchanged() || isCurrentOwner() || isLegitimateAutoClaim())
                    && (membersAppendOnly() || isCurrentOwner() || selfRemoveOnly())
                    // finances is head-coach-only (docs/FINANCES-AUDIT.md
                    // finding 3.1). Reads cannot be field-gated on a single
                    // doc, so assistants can still READ finances — a
                    // documented, accepted residual.
                    && (untouched('finances') || isHeadCoach())
                    // Without this, any member could self-promote to 'head'
                    // with a plain coachRoles write and then sail through the
                    // finances gate above.
                    && (untouched('coachRoles') || isHeadCoach())
                    // The Venmo link lands in offer letters families pay
                    // from: only a head may change it, and only to a real
                    // https Venmo address (or clear it). Checked only when it
                    // CHANGES, so a legacy value already stored never blocks
                    // the team's other saves.
                    && (untouched('coachVenmoLink')
                        || (isHeadCoach()
                            && venmoLinkOk(request.resource.data.get('coachVenmoLink', ''))))
                    // evaluationEvents is a DROPPED legacy field (finding 3.1
                    // — rounds live in the evalRounds subcollection below).
                    // Ratchet: a doc still carrying the array may rewrite or
                    // remove it (schema-ladder migration, the deleteField
                    // drop), but once gone no write may recreate it — that
                    // would put scoped eval data back on the shared doc.
                    && (!('evaluationEvents' in request.resource.data)
                        || ('evaluationEvents' in resource.data))
                    // tryoutSignups / interestSignups are the next fields on
                    // the same ladder (Phase 1 of
                    // docs/firestore-data-migration.md — signups live in the
                    // per-entry subcollections below; the coach client drops
                    // each team's arrays with deleteField once the backfill
                    // provably covers them). Same ratchet shape: a doc still
                    // carrying an array may rewrite or remove it (a stale
                    // pre-drop client's `tryoutSignups: []` season overwrite,
                    // exact-entry arrayRemove cleanup, the deleteField drop),
                    // but once a team's array is gone no write may recreate
                    // it — a stale client fails LOUDLY instead of silently
                    // resurrecting the dropped field. NOTE: request.resource
                    // is the POST-write doc, so a write that doesn't touch a
                    // key still "carries" it while the doc has it — which is
                    // exactly why ordinary writes keep passing pre-drop and
                    // post-drop alike.
                    && (!('tryoutSignups' in request.resource.data)
                        || ('tryoutSignups' in resource.data))
                    && (!('interestSignups' in request.resource.data)
                        || ('interestSignups' in resource.data))
                    // playerInfoSubmissions / availabilitySubmissions are the
                    // last two fields on the ladder (Phase 1b — submissions
                    // live in the per-entry subcollections below). With their
                    // deprecated public append lanes now REMOVED (the Phase 1b
                    // exit), this ratchet is the whole story: once a team's
                    // array is dropped, NO write from anyone may recreate it.
                    && (!('playerInfoSubmissions' in request.resource.data)
                        || ('playerInfoSubmissions' in resource.data))
                    && (!('availabilitySubmissions' in request.resource.data)
                        || ('availabilitySubmissions' in resource.data))
                    // games is the first COACH-written array on the ladder
                    // (Phase 3a — per-doc in the games subcollection below).
                    // No public lane ever existed for it, so this ratchet is
                    // total from day one: pre-drop member writes that carry
                    // the array keep working, and once a team's array is
                    // dropped no write may recreate it.
                    && (!('games' in request.resource.data)
                        || ('games' in resource.data))
                    // players is the LAST array on the ladder (Phase 3b —
                    // per-doc in the players subcollection below). Same total
                    // ratchet as games, and the same reason it is safe: no
                    // public lane ever existed, so once a team's array is
                    // dropped the only writers that could recreate it are
                    // stale coach clients, which now fail LOUDLY here instead
                    // of silently writing a roster the union no longer reads.
                    && (!('players' in request.resource.data)
                        || ('players' in resource.data));

      // Only the current owner can delete the team document.
      allow delete: if isCurrentOwner();

      // Team bootstrap: signed-in creator can create a new team doc when
      // ownerId is set to their UID. A new doc can never be born with a
      // dropped legacy field — evaluationEvents, tryoutSignups,
      // interestSignups, playerInfoSubmissions, availabilitySubmissions (see
      // the update-rule ratchets) — combined, each field can only ever
      // disappear from the fleet. createTeam writes NEW_TEAM_DOC
      // (src/constants/ui.ts), which seeds none of them; backup restore
      // merges onto an existing doc and strips them too (backupSanitizer).
      allow create: if isCoachAccount()
                    && request.resource.data.ownerId == request.auth.uid
                    && !('evaluationEvents' in request.resource.data)
                    && !('tryoutSignups' in request.resource.data)
                    && !('interestSignups' in request.resource.data)
                    && !('playerInfoSubmissions' in request.resource.data)
                    && !('availabilitySubmissions' in request.resource.data)
                    && !('games' in request.resource.data)
                    && !('players' in request.resource.data);

      // NOTE: there is deliberately NO "read if a join code exists" rule here.
      // The old `allow read: if isSignedIn() && resource.data.joinCode != null;`
      // leaked the ENTIRE private team doc (roster, evaluations, every family's
      // signup PII, member UIDs, ownerId) to any signed-in user who merely knew
      // a code existed. Join-code resolution now goes through the sanitized
      // /teamInvites/{code} lookup doc below, which exposes only teamId +
      // teamName; the constrained self-join update rule still lets the invited
      // user add themselves to this team doc without reading it.

      // Join-code self-join path. The caller must PROVE the code: the write
      // carries lastJoin {uid, code} and the code must equal this team's
      // current joinCode. (Before, the rule only checked that the team HAD a
      // code — anyone who learned a team id could add themselves.) Coach
      // accounts only: a parent's anonymous form session can never join. The
      // caller may only modify members + coachRoles (+ the proof), can never
      // shrink the members list, and must add themselves as a member by the
      // end of the write. The base-update rule's ownerId protection still
      // applies on top of this — a code-holder cannot rewrite the ownership
      // shape.
      allow update: if isCoachAccount()
                    && resource.data.joinCode != null
                    && request.resource.data.lastJoin.uid == request.auth.uid
                    && request.resource.data.lastJoin.code == resource.data.joinCode
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['members', 'coachRoles', 'lastJoin'])
                    && membersAppendOnly()
                    // The caller may add exactly themselves — never smuggle
                    // extra uids into members in the same write.
                    && nextMembers().toSet().difference(prevMembers().toSet())
                         .hasOnly([request.auth.uid])
                    && request.auth.uid in nextMembers()
                    && coachRolesSelfJoinValid();

      // Public portal write paths: ALL REMOVED. Every portal-written family
      // — tryout signups, interest leads (Phase 1 exit, #582+), player-info
      // and availability submissions (Phase 1b exit) — now lands as per-entry
      // docs in the subcollections below; there is no public write to the
      // team doc at all, and deliberately NO public *read* of it either (the
      // portals read branding + tryout config from the sanitized teamPublic
      // mirror). Each deprecated append-exactly-one array lane was kept
      // exactly one release for cached portal clients and then deleted; the
      // network-first service worker keeps portal bundles fresh, so no
      // supported client appends to the arrays anymore. A straggler's
      // arrayUnion now fails LOUDLY with permission-denied (the portal's
      // submit catch shows its retry-or-contact-the-coach error instead of
      // silently succeeding into a doomed array). The ratchets in the base
      // update rule stay: a team doc that still carries a legacy array may
      // rewrite/clean/drop it (coach-side shapes), but once dropped nothing
      // recreates it — with the lanes gone, the per-team deleteField drop is
      // genuinely irreversible for every one of the four fields.

      // ----- Shared helpers for the subcollections below (evalRounds,
      // tryoutSignups, interestSignups, playerInfoSubmissions,
      // availabilitySubmissions). A subcollection rule can't see the
      // parent team doc as `resource`, so membership is evaluated via a
      // get() on it (one billed read per request — Firestore caches repeat
      // get()s of the same doc within a single evaluation).
      function teamDoc() {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function isTeamMember() {
        return isSignedIn() && (
          teamDoc().ownerId == request.auth.uid ||
          (teamDoc().members != null && request.auth.uid in teamDoc().members)
        );
      }
      // Head coach = owner OR a member promoted to 'head' via coachRoles,
      // matching isHeadCoach() on the team doc.
      function isTeamHead() {
        return isSignedIn() && (
          teamDoc().ownerId == request.auth.uid ||
          teamDoc().get('coachRoles', {}).get(request.auth.uid, '') == 'head'
        );
      }

      // A PUBLIC writer may only create at a Firestore auto-id (20 chars),
      // and the in-data `id` must match the doc id.
      //
      // This is what stops legacy-id shadowing. Legacy array entries carry
      // genId ids ("ts-xxxxxxxx" / "int-xxxxxxxx", 11-12 chars, Math.random
      // and explicitly not secret). Without a length floor an anonymous
      // caller could plant a doc at a KNOWN legacy id; assembleSignups gives
      // subcollection docs precedence on id conflict, the lazy backfill then
      // skips that id as "already migrated", and the head-only drop finally
      // deletes the legacy array — permanently replacing a real family's
      // signup with attacker content. Members stay unconstrained precisely so
      // the backfill CAN preserve those short legacy ids.
      function publicSignupIdOk(docId) {
        return docId.size() == 20
          && (!('id' in request.resource.data)
              || request.resource.data.id == docId);
      }

      // Per-field caps for the PUBLIC portal create lane on the signup
      // subcollections. Mirrors SIGNUP_LIMITS in src/utils/helpers.ts with
      // headroom so a legitimately clamped client payload can never be
      // edge-rejected by an off-by-one. Every field is optional (the
      // per-collection hasOnly() allowlist bounds the set) — but a PRESENT
      // field must be a string within its cap.
      function signupStrOk(key, max) {
        return !(key in request.resource.data)
          || (request.resource.data[key] is string
              && request.resource.data[key].size() <= max);
      }
      // canPitch/canCatch/isCatcher — the portal stamps booleans; tolerate a
      // short string so an older payload shape ("yes"/"no") still lands.
      function signupFlagOk(key) {
        return !(key in request.resource.data)
          || request.resource.data[key] is bool
          || (request.resource.data[key] is string
              && request.resource.data[key].size() <= 60);
      }
      function signupCapsOk() {
        return signupStrOk('id', 60)
          && signupStrOk('submittedAt', 40)
          && signupStrOk('firstName', 60)
          && signupStrOk('lastName', 60)
          && signupStrOk('dob', 40)
          && signupStrOk('parentName', 80)
          && signupStrOk('email', 254)
          && signupStrOk('phone', 40)
          && signupStrOk('currentTeam', 80)
          && signupStrOk('number', 60)
          && signupStrOk('bats', 60)
          && signupStrOk('throws', 60)
          && signupStrOk('primaryPosition', 60)
          && signupStrOk('secondaryPosition', 60)
          // The portal derives this list purely from the two declared
          // positions (TryoutsPortal: Set([primary, secondary]).filter), so
          // constraining it to that subset bounds the ELEMENTS too — both are
          // already string-capped above. Without this an element could be a
          // ~1 MiB string or a nested map, voiding the whole payload envelope
          // and feeding non-strings to coach code that assumes position codes.
          && (!('comfortablePositions' in request.resource.data)
              || (request.resource.data.comfortablePositions is list
                  && request.resource.data.comfortablePositions.size() <= 12
                  && request.resource.data.comfortablePositions.toSet().hasOnly([
                       request.resource.data.get('primaryPosition', ''),
                       request.resource.data.get('secondaryPosition', '')
                     ])))
          && signupFlagOk('canPitch')
          && signupFlagOk('canCatch')
          && signupFlagOk('isCatcher')
          && signupStrOk('tryoutDate', 40)
          && signupStrOk('notes', 600)
          && signupStrOk('status', 60);
      }

      // ----- Per-author evaluation rounds (docs/eval-authz-design.md, Option
      // A — the fix for audit finding 3.1). This subcollection is the SOLE
      // home for eval rounds: reads and writes are authorization-scoped — an
      // assistant sees and edits only their OWN rounds; a head coach (the
      // owner or a coachRoles 'head') manages every round. The old
      // `evaluationEvents` array on the shared team doc (which no rule could
      // field-scope) has been dropped; the ratchet in the base update rule
      // above keeps it from ever coming back.
      match /evalRounds/{roundId} {
        // The signed-in caller authored this existing round.
        function isOwnRound() {
          return isSignedIn() && resource.data.evaluatorId == request.auth.uid;
        }

        // Head reads every round; an assistant reads only their own. This also
        // scopes list queries: a head may list all, an assistant only a
        // `where evaluatorId == me` query.
        allow read: if isTeamHead() || isOwnRound();
        // A member may create a round only when it is stamped with their own
        // uid — nobody can plant a round under someone else's name.
        allow create: if isTeamMember()
                      && request.resource.data.evaluatorId == request.auth.uid;
        // Head manages every round; an author manages their own. evaluatorId is
        // immutable on update, so a round can never be reassigned to a
        // different author (delete + recreate instead).
        allow update: if (isTeamHead() || isOwnRound())
                      && request.resource.data.evaluatorId == resource.data.evaluatorId;
        allow delete: if isTeamHead() || isOwnRound();
      }

      // ----- Per-entry public signups (Phase 1 of
      // docs/firestore-data-migration.md). New portal submissions land as one
      // doc per signup here instead of growing the 1 MiB team doc's arrays;
      // the coach client presents the union of these docs + any legacy array
      // entries and lazily backfills stragglers (src/utils/tryoutSignupDocs.ts).
      // READ is member-only — a signup is a family's PII, never public.
      // CREATE stays open to any signed-in caller (anonymous portal auth
      // counts) under the same team-state gates the removed array lanes used
      // (tryoutsOpen / tryoutShareId), plus a payload allowlist + size caps
      // the array diff could never express. UPDATE/DELETE are member-only: a
      // visitor can add their
      // own signup but never touch anyone else's (or revise their own —
      // coaches curate; a family resubmits instead).
      match /tryoutSignups/{signupId} {
        function portalKeysOnly() {
          return request.resource.data.keys().hasOnly([
            'id', 'submittedAt', 'firstName', 'lastName', 'dob', 'parentName',
            'email', 'phone', 'currentTeam', 'number', 'bats', 'throws',
            'primaryPosition', 'secondaryPosition', 'comfortablePositions',
            'canPitch', 'canCatch', 'isCatcher', 'tryoutDate', 'notes',
            'status'
          ]);
        }
        allow read: if isTeamMember();
        // Member create is deliberately unconstrained: the lazy backfill
        // copies legacy array entries verbatim (they may predate the portal
        // payload shape), and coach-added entries don't follow it either.
        allow create: if isTeamMember()
                      || (isSignedIn()
                          && teamDoc().tryoutsOpen == true
                          && publicSignupIdOk(signupId)
                          && portalKeysOnly()
                          && signupCapsOk()
                          // A public writer may only ever mint a NEW signup.
                          // Coach curation (offered/accepted/declined) drives
                          // roster projection and the advance-season deposit
                          // filters, so it must not be self-declarable.
                          && (!('status' in request.resource.data)
                              || request.resource.data.status == 'tryout'));
        allow update, delete: if isTeamMember();
      }

      match /interestSignups/{leadId} {
        // Same allowlist minus `status` — a lead has no tryout status until a
        // coach converts it.
        function portalKeysOnly() {
          return request.resource.data.keys().hasOnly([
            'id', 'submittedAt', 'firstName', 'lastName', 'dob', 'parentName',
            'email', 'phone', 'currentTeam', 'number', 'bats', 'throws',
            'primaryPosition', 'secondaryPosition', 'comfortablePositions',
            'canPitch', 'canCatch', 'isCatcher', 'tryoutDate', 'notes'
          ]);
        }
        allow read: if isTeamMember();
        // Interest is collected year-round — gated on the standing share
        // link existing (the gate the removed array lane used).
        allow create: if isTeamMember()
                      || (isSignedIn()
                          && teamDoc().tryoutShareId != null
                          && publicSignupIdOk(leadId)
                          && portalKeysOnly()
                          && signupCapsOk());
        allow update, delete: if isTeamMember();
      }

      // ----- Per-entry portal submissions (Phase 1b of
      // docs/firestore-data-migration.md — the last two public-write lanes
      // move off the 1 MiB team doc, mirroring the tryout/interest signups
      // above). READ is member-only (family PII); CREATE stays open to any
      // signed-in caller (anonymous portal auth counts) under the standing
      // share-link gate the deprecated array lanes use, plus a field
      // allowlist + per-field size caps. UPDATE/DELETE are member-only.
      //
      // appliedToPlayerId / appliedAt are deliberately OFF the public
      // allowlists: a coach stamps them when applying a submission onto a
      // roster player, and a self-declared "already handled" flag would hide
      // a hostile submission from the inbox.
      match /playerInfoSubmissions/{subId} {
        function portalKeysOnly() {
          return request.resource.data.keys().hasOnly([
            'id', 'submittedAt', 'firstName', 'lastName', 'dob', 'number',
            'hatSize', 'shirtSize', 'pantsSize', 'height', 'weight',
            'school', 'grade', 'parentName', 'email', 'phone',
            'parent2Name', 'parent2Phone', 'parent2Email', 'notes'
          ]);
        }
        // Mirrors the PlayerInfoPortal clamps (SIGNUP_LIMITS) with headroom,
        // same policy as signupCapsOk above.
        function playerInfoCapsOk() {
          return signupStrOk('id', 60)
            && signupStrOk('submittedAt', 40)
            && signupStrOk('firstName', 60)
            && signupStrOk('lastName', 60)
            && signupStrOk('dob', 40)
            && signupStrOk('number', 60)
            && signupStrOk('hatSize', 60)
            && signupStrOk('shirtSize', 60)
            && signupStrOk('pantsSize', 60)
            && signupStrOk('height', 60)
            && signupStrOk('weight', 60)
            && signupStrOk('school', 80)
            && signupStrOk('grade', 60)
            && signupStrOk('parentName', 80)
            && signupStrOk('email', 254)
            && signupStrOk('phone', 40)
            && signupStrOk('parent2Name', 80)
            && signupStrOk('parent2Phone', 40)
            && signupStrOk('parent2Email', 254)
            && signupStrOk('notes', 600);
        }
        allow read: if isTeamMember();
        // Member create is unconstrained so the lazy backfill can copy legacy
        // array entries verbatim (they may carry emergencyName/emergencyPhone
        // or an applied stamp the portal shape never sends).
        allow create: if isTeamMember()
                      || (isSignedIn()
                          && teamDoc().tryoutShareId != null
                          && publicSignupIdOk(subId)
                          && portalKeysOnly()
                          && playerInfoCapsOk());
        allow update, delete: if isTeamMember();
      }

      // ----- Per-entry games (Phase 3a of docs/firestore-data-migration.md
      // — the first coach-written array off the 1 MiB team doc). No public
      // lane ever existed for games, so the block reduces to member-only
      // everything. Member create is deliberately unconstrained: the lazy
      // backfill copies legacy array entries VERBATIM, including their short
      // genId ids ("g-xxxxxxxx") — do not add an id-length floor here, that
      // guard exists on the PUBLIC portal lanes only.
      match /games/{gameId} {
        allow read, create, update, delete: if isTeamMember();
      }

      // ----- Per-entry players (Phase 3b of docs/firestore-data-migration.md
      // — the LAST array off the 1 MiB team doc). Same shape as games: no
      // public lane ever existed for the roster, so member-only everything,
      // and member create stays unconstrained so the lazy backfill copies
      // legacy array entries VERBATIM at their short genId ids. Do not add an
      // id-length floor here — that guard belongs to the PUBLIC portal lanes.
      //
      // Note this is a stricter home than the roster had before: the team doc
      // is readable by every member, and so is this, but a roster entry can no
      // longer ride along in a doc that some other rule exposed — every read
      // of a player now resolves membership on its own.
      match /players/{playerId} {
        allow read, create, update, delete: if isTeamMember();
      }

      match /availabilitySubmissions/{subId} {
        function portalKeysOnly() {
          return request.resource.data.keys().hasOnly([
            'id', 'submittedAt', 'firstName', 'lastName', 'dob',
            'parentName', 'email', 'phone', 'dates', 'blocks'
          ]);
        }
        // dates/blocks are lists rules can only bound in LENGTH (no
        // per-element checks without a fixed value set). The portal caps both
        // at 366; 400 leaves headroom. Accepted residual: a hostile element
        // can be oversized, but it now bloats only its own per-entry doc
        // (bounded by Firestore's 1 MiB per-doc cap) — never the shared team
        // doc the array lanes used to grow.
        function availabilityCapsOk() {
          return signupStrOk('id', 60)
            && signupStrOk('submittedAt', 40)
            && signupStrOk('firstName', 60)
            && signupStrOk('lastName', 60)
            && signupStrOk('dob', 40)
            && signupStrOk('parentName', 80)
            && signupStrOk('email', 254)
            && signupStrOk('phone', 40)
            && (!('dates' in request.resource.data)
                || (request.resource.data.dates is list
                    && request.resource.data.dates.size() <= 400))
            && (!('blocks' in request.resource.data)
                || (request.resource.data.blocks is list
                    && request.resource.data.blocks.size() <= 400));
        }
        allow read: if isTeamMember();
        allow create: if isTeamMember()
                      || (isSignedIn()
                          && teamDoc().tryoutShareId != null
                          && publicSignupIdOk(subId)
                          && portalKeysOnly()
                          && availabilityCapsOk());
        allow update, delete: if isTeamMember();
      }
    }

    // Sanitized public mirror of a team, maintained by the coach client
    // (see buildPublicMirror in src/utils/helpers.ts). Holds only branding +
    // tryout config — never roster, schedule, evaluations, signups, members,
    // ownerId, coachRoles, or joinCode. The Tryouts Portal (anonymous auth)
    // reads it; only members of the underlying team may write it.
    match /artifacts/{appId}/public/data/teamPublic/{teamId} {
      function mainTeam() {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function isTeamMember() {
        return request.auth != null && (
          mainTeam().ownerId == request.auth.uid ||
          (mainTeam().members != null
            && request.auth.uid in mainTeam().members)
        );
      }

      // Anonymous portal visitors (signed in anonymously) may read the mirror.
      allow read: if request.auth != null;
      // Only a member of the real team can create/update/delete the mirror.
      allow write: if isTeamMember();
    }

    // Parent-form links, keyed by the link's slug (the team's tryoutShareId):
    // { teamId }. The forms resolve a slug HERE first — one document, by id —
    // so a link can't be hijacked by another team publishing a mirror with the
    // same share id (the listable mirror query is only the fallback for teams
    // whose link doc doesn't exist yet; see docs/firebase-rules-rollout.md).
    match /artifacts/{appId}/public/data/portalLinks/{slug} {
      function linkTeam(teamId) {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function linkTeamAfter(teamId) {
        return getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function isLinkTeamMember(teamId) {
        return request.auth != null
          && (linkTeam(teamId).ownerId == request.auth.uid
              || (linkTeam(teamId).members != null
                  && request.auth.uid in linkTeam(teamId).members));
      }
      // Any signed-in session (a parent's anonymous one included) may look up
      // ONE link by its slug — `get`, never `list`.
      allow get: if request.auth != null;
      // Created by a member, only for their team's CURRENT share id, holding
      // nothing but the team id. Create-once: there is no update, so a link
      // can never be repointed at another team.
      allow create: if isCoachAccount()
        && request.resource.data.keys().hasOnly(['teamId', 'createdAt'])
        && request.resource.data.teamId is string
        && isLinkTeamMember(request.resource.data.teamId)
        && linkTeamAfter(request.resource.data.teamId).tryoutShareId == slug;
      // A rotated-out link is cleaned up by a member of its team.
      allow delete: if isCoachAccount() && isLinkTeamMember(resource.data.teamId);
    }

    // Game and practice DAYS for the parent availability form, keyed by the
    // form link's slug (the team's tryoutShareId): { teamId, gameDays,
    // practiceDays, updatedAt } — bare yyyy-mm-dd dates, nothing else. Kept
    // out of teamPublic on purpose: that mirror is listable, so dates there
    // would publish every team's schedule. Here a reader needs the link.
    // Published only when the head coach turns it on (see
    // src/utils/portalSchedule.ts).
    match /artifacts/{appId}/public/data/portalSchedules/{slug} {
      function schedTeam(teamId) {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function isSchedTeamMember(teamId) {
        return request.auth != null
          && (schedTeam(teamId).ownerId == request.auth.uid
              || (schedTeam(teamId).members != null
                  && request.auth.uid in schedTeam(teamId).members));
      }
      // The slug's owned link doc (create-once, never repointed) must name
      // the same team — so a team that copies another's share id can't
      // squat this doc and show families its own dates.
      function linkIsTeams(teamId) {
        return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/portalLinks/$(slug))
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/portalLinks/$(slug)).data.teamId == teamId;
      }
      // ONE doc by its slug — `get`, never `list`.
      allow get: if request.auth != null;
      // Written by a member, only under their team's CURRENT share id and
      // link, with only these fields and short lists, and never moved to
      // another team.
      allow create, update: if isCoachAccount()
        && request.resource.data.keys().hasOnly(['teamId', 'gameDays', 'practiceDays', 'updatedAt'])
        && request.resource.data.teamId is string
        && request.resource.data.gameDays is list
        && request.resource.data.gameDays.size() <= 150
        && request.resource.data.practiceDays is list
        && request.resource.data.practiceDays.size() <= 150
        && isSchedTeamMember(request.resource.data.teamId)
        && schedTeam(request.resource.data.teamId).tryoutShareId == slug
        && linkIsTeams(request.resource.data.teamId)
        && (resource == null || resource.data.teamId == request.resource.data.teamId);
      allow delete: if isCoachAccount() && isSchedTeamMember(resource.data.teamId);
    }

    // Sanitized invite lookup, keyed by join code. Replaces the old "read the
    // whole team doc if it has a join code" rule: a code-holder resolves the
    // code to a teamId + teamName here (nothing private), then performs the
    // constrained self-join update against the real team doc (which re-checks
    // the code). Maintained by the coach client (see regenerateJoinCode /
    // invite backfill in TeamProvider).
    match /artifacts/{appId}/public/data/teamInvites/{code} {
      function teamData(teamId) {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function teamDataAfter(teamId) {
        return getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data;
      }
      function isMemberOfTeam(teamId) {
        return request.auth != null
          && (teamData(teamId).ownerId == request.auth.uid
              || (teamData(teamId).members != null
                  && request.auth.uid in teamData(teamId).members));
      }

      // A coach account may look up ONE invite by its code — `get`, never
      // `list`: listing would hand out every team's code. The doc is
      // sanitized — only teamId, teamName, and updatedAt.
      allow get: if isCoachAccount();
      // Only a member of the team may create its invite, and only for the
      // team's REAL current code — so a code can't be planted for another
      // team, and a team can't squat a code it doesn't hold. (getAfter: the
      // code may be set in the same batch.)
      allow create: if isCoachAccount()
        && request.resource.data.teamId is string
        && isMemberOfTeam(request.resource.data.teamId)
        && teamDataAfter(request.resource.data.teamId).joinCode == code;
      // Refresh (the backfill write / a team rename) — by a member of the team
      // the invite ALREADY points at, and never repointed elsewhere.
      allow update: if isCoachAccount()
        && request.resource.data.teamId == resource.data.teamId
        && isMemberOfTeam(resource.data.teamId);
      // Code rotation deletes the stale invite; limited to a team member.
      allow delete: if isCoachAccount() && isMemberOfTeam(resource.data.teamId);
    }
  }
}
